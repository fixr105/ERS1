        "jsCode": "function pickSession(obj) {\n  if (!obj || typeof obj !== 'object') return null;\n  const body = obj.body || {};\n  const candidates = [obj.sessionId, body.sessionId, obj.Session, body.Session];\n  for (const c of candidates) {\n    if (typeof c === 'string' && /^rec[A-Za-z0-9]{10,}$/.test(c)) return c;\n    if (Array.isArray(c) && typeof c[0] === 'string' && /^rec[A-Za-z0-9]{10,}$/.test(c[0])) return c[0];\n  }\n  return null;\n}\nfunction nodeJson(name) {\n  try { return $(name).first().json || {}; } catch (e) { return {}; }\n}\n\nconst uploadResp = $input.first().json || {};\nconst jobId = uploadResp.body?.id || uploadResp.id || null;\nconst extracted = nodeJson('Extract File');\nconst webhook = nodeJson('WH Ingest File');\n\nreturn [{\n  json: {\n    bank_job_id: jobId,\n    bank_retry: 0,\n    bank_done: false,\n    bank_error: !jobId,\n    sessionId: pickSession(extracted) || pickSession(webhook) || null,\n    employeeId: extracted.employeeId || extracted.body?.employeeId || webhook.employeeId || webhook.body?.employeeId || null,\n    name: extracted.name || extracted.body?.name || webhook.name || webhook.body?.name || 'upload.pdf',\n    type: extracted.type || extracted.body?.type || webhook.type || webhook.body?.type || 'application/pdf',\n    fileId: null,\n  },\n}];"
